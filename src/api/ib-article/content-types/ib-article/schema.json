{
  "kind": "collectionType",
  "collectionName": "ib_articles",
  "info": {
    "singularName": "ib-article",
    "pluralName": "ib-articles",
    "displayName": "IB_Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "metaTitle": {
      "type": "string"
    },
    "metaDescription": {
      "type": "text"
    },
    "schema": {
      "type": "json"
    },
    "slug": {
      "type": "text"
    },
    "title": {
      "type": "text"
    },
    "description": {
      "type": "text"
    },
    "readTime": {
      "type": "string"
    },
    "createdDate": {
      "type": "date"
    },
    "listingImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "sections": {
      "type": "component",
      "component": "shared.os-blog-sections",
      "repeatable": true
    },
    "foundersbar_authors": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::foundersbar-author.foundersbar-author",
      "inversedBy": "ib_articles"
    },
    "footerCTA": {
      "type": "json"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "courses",
        "careerAdvice",
        "interviewPreparation"
      ]
    }
  }
}
